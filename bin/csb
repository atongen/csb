#!/usr/bin/env bash
#
# csb (claude sandbox) -- run Claude Code (or a shell) in a per-branch git
# worktree, inside the repo's own nix devShell, behind an env scrub, a private
# HOME, and a filesystem sandbox: deny-list reads + a write allow-list (seatbelt
# on macOS, bubblewrap on Linux). Network and host services stay open by design.
#
# Usage: csb --help    Design, threat model, and config: README.md and docs/.
#
# Env: CSB_SELF   flake ref csb pulls the claude binary from (default: the
#                 private remote; override with CSB_SELF=path:/path/to/csb).
#      CSB_LATEST non-empty defaults -L/--latest on.
#      CSB_LATEST_TTL seconds to reuse a cached upstream claude-code rev under
#                 -L/--latest before re-checking (default 86400 = daily; 0 =
#                 check every run).
#      CSB_VERBOSE non-empty defaults -v/--verbose on (launches are otherwise
#                 quiet: routine status + nix progress suppressed).
#      CSB_BWRAP_BIN (Linux) use this bwrap binary verbatim instead of building
#                 it via nix (keeps --dump-sandbox / tests hermetic).
#      CSB_PROXY_BIN use this csb-proxy binary verbatim instead of resolving
#                 "$CSB_SELF#csb-tools" (same purpose, for --filter-egress).
#      CSB_CONFIG_BIN use this csb-config binary verbatim instead of searching
#                 beside this script, then ~/.csb/bin, then $PATH.
#
# Config resolution -- the flag grammar, the profiles, the validation, --help
# and --dump-config -- belongs to csb-config, not to this script; see
# docs/PLAN-008-proxy.md section 9. This script keeps git, nix and exec.

set -euo pipefail

PROG=$(basename "$0")

# csb supplies the claude binary from its own flake (so repos stay decoupled).
# Default: the private remote. For local dev against a working tree,
# override: CSB_SELF=path:/path/to/csb csb ...
CSB_SELF="${CSB_SELF:-git+ssh://git@git.grandrew.com/atongen/csb.git}"
# A path: ref must be PHYSICAL: nix refuses one with a symlinked ancestor
# ("path '/Users/you/src' is a symlink"), and a symlinked source tree is a
# common layout. Left as given when the directory does not exist, so the error
# stays nix's. Same resolution repo_key does for namespace identity.
case "$CSB_SELF" in
  path:/*) CSB_SELF="path:$(cd "${CSB_SELF#path:}" 2>/dev/null && pwd -P || printf '%s' "${CSB_SELF#path:}")" ;;
esac

CSB_NS_ROOT="$HOME/.csb/claudes"
# Where `make install` puts csb's native helpers. Deliberately NOT the bin dir
# holding the csb script: that dir is meant to hold portable content and is
# commonly under version control, which a per-platform binary must not enter.
# Outside every sandbox write root, which matters -- csb-config decides policy
# and runs unsandboxed, so a writable one would be a persistence vector of the
# same class as .git/hooks. The launch HOMEs under claudes/ are write roots;
# this sibling is not.
CSB_TOOLS_DIR="$HOME/.csb/bin"
CSB_CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/csb"
CSB_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/csb"

die() { echo "$PROG: $*" >&2; exit 1; }

# Verbose-only narration. Launches are quiet by default (routine status lines and
# nix's own progress are suppressed); -v/--verbose (or CSB_VERBOSE) restores them.
# Warnings, errors (die), and command results always print regardless.
vecho() { if [[ "$verbose" == "true" ]]; then echo "$@" >&2; fi; }

# --- --latest upstream rev cache ----------------------------------------------

CSB_CLAUDE_FLAKE="github:sadjow/claude-code-nix"

# Resolve claude-code's upstream HEAD commit, re-checking at most once per
# CSB_LATEST_TTL seconds (0 = every run) and caching <epoch> <sha> in
# CSB_CACHE_DIR. Pinning the override to this concrete rev keeps subsequent
# same-day launches fully cached (no fetch) and reproducible within the window.
latest_claude_rev() {
  local cache="$CSB_CACHE_DIR/latest-claude-rev" \
        ttl="${CSB_LATEST_TTL:-86400}" now stamp sha
  [[ "$ttl" =~ ^[0-9]+$ ]] || die "CSB_LATEST_TTL must be a whole number of seconds: '$ttl'"
  now="$(date +%s)"
  if [[ "$ttl" -gt 0 && -f "$cache" ]]; then
    read -r stamp sha <"$cache" || true
    if [[ "$stamp" =~ ^[0-9]+$ && -n "$sha" && $((now - stamp)) -lt "$ttl" ]]; then
      vecho "$PROG: --latest: using cached upstream rev ${sha:0:12}"
      echo "$sha"; return
    fi
  fi
  sha="$(git ls-remote "https://github.com/${CSB_CLAUDE_FLAKE#github:}" HEAD | cut -f1)"
  [[ -n "$sha" ]] || die "--latest: could not resolve upstream HEAD of $CSB_CLAUDE_FLAKE"
  mkdir -p "$CSB_CACHE_DIR"
  printf '%s %s\n' "$now" "$sha" >"$cache"
  vecho "$PROG: --latest: checked upstream HEAD -> ${sha:0:12}"
  echo "$sha"
}

# --- git / worktree helpers ---------------------------------------------------

# Percent-encode a branch into one filesystem-safe path component, injectively
# (% first, then /): feature/foo -> feature%2Ffoo, so no two branches collide.
# Used only for the .worktrees/<branch> path; namespaces are no longer per-branch.
encode_branch() {
  local s="$1"
  s="${s//%/%25}"
  s="${s//\//%2F}"
  echo "$s"
}

worktree_path() {
  local repo_root="$1" branch="$2"
  echo "$repo_root/.worktrees/$(encode_branch "$branch")"
}

# The physical main-checkout root: the one path that identifies a repository,
# whichever of its worktrees you are standing in. Resolving the common dir +
# pwd -P maps every path into a repo onto one root. Empty outside a repository.
# It is both the namespace key below and the path csb-config matches its config
# sections against.
main_checkout_root() {
  local root="${1:-.}" gc
  gc=$(git -C "$root" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 0
  (cd "$(dirname "$gc")" 2>/dev/null && pwd -P) || true
}

# Stable, filesystem-safe repo identity: basename of the physical main-checkout
# root + a short hash of its full path (keeps same-named checkouts apart), so
# namespaces scoped by it never share (or -d) config across repos.
repo_key() {
  local phys
  phys=$(main_checkout_root "$1")
  printf '%s-%x\n' "$(basename "$phys")" "$(printf '%s' "$phys" | cksum | cut -d' ' -f1)"
}

# In a linked worktree, --git-dir and --git-common-dir differ.
in_worktree() {
  local gd cd
  gd=$(git rev-parse --path-format=absolute --git-dir 2>/dev/null) || return 1
  cd=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 1
  [[ "$gd" != "$cd" ]]
}

# Echo the registered worktree path for $branch, else nothing.
find_worktree() {
  local repo_root="$1" branch="$2"
  git -C "$repo_root" worktree list --porcelain 2>/dev/null | \
    awk -v want="branch refs/heads/$branch" '
      /^worktree / { wt = substr($0, 10) }
      $0 == want   { print wt; exit }
    '
}

branch_exists() {
  local repo_root="$1" branch="$2"
  git -C "$repo_root" show-ref --verify --quiet "refs/heads/$branch" || \
    git -C "$repo_root" show-ref --verify --quiet "refs/remotes/origin/$branch"
}

# Echo the worktree path, creating/reusing as needed. Branch is created off the
# current HEAD if it doesn't already exist.
ensure_worktree() {
  local repo_root="$1" branch="$2" existing path
  existing=$(find_worktree "$repo_root" "$branch")
  if [[ -n "$existing" ]]; then
    # Reuse only a real csb worktree under .worktrees/. If the branch is checked
    # out elsewhere (commonly the main tree, when you're already on it), git
    # won't allow a second checkout — fail with guidance instead of returning
    # the wrong path.
    case "$existing" in
      "$repo_root"/.worktrees/*)
        echo "$existing"
        return 0
        ;;
      *)
        echo "$PROG: branch '$branch' is already checked out at: $existing" >&2
        echo "  a branch can live in only one worktree. Switch to your base branch" >&2
        echo "  (e.g. main) — or pick a different name — then: $PROG $branch" >&2
        return 1
        ;;
    esac
  fi
  path=$(worktree_path "$repo_root" "$branch")
  if branch_exists "$repo_root" "$branch"; then
    git -C "$repo_root" worktree add "$path" "$branch" >&2
  else
    git -C "$repo_root" worktree add -b "$branch" "$path" >&2
  fi
  echo "$path"
}

# Copy gitignored files matching <repo>/.worktreeinclude into a fresh worktree.
# Only files that match a pattern AND are gitignored are copied; existing files
# in the worktree are never overwritten. No-op if .worktreeinclude is missing.
# .worktreesetup.sh may be listed here too -- it no longer needs to be
# git-tracked to run (see run_worktreesetup), so a personal, gitignored copy
# can ride in this way just like any other local file.
process_worktreeinclude() {
  local repo_root="$1" wt_path="$2"
  local include_file="$repo_root/.worktreeinclude"
  [[ -f "$include_file" ]] || return 0

  local count=0 f src dest
  while IFS= read -r f; do
    [[ -z "$f" ]] && continue
    git -C "$repo_root" check-ignore -q -- "$f" || continue
    src="$repo_root/$f"
    [[ -e "$src" ]] || continue
    dest="$wt_path/$f"
    [[ -e "$dest" ]] && continue
    mkdir -p "$(dirname "$dest")"
    # -R: nested git repos (e.g. bundler git-sourced gems) surface as single
    # directory entries in ls-files --others output.
    cp -pR "$src" "$dest"
    count=$((count + 1))
  done < <(git -C "$repo_root" ls-files --others -i --exclude-from="$include_file")

  if (( count > 0 )); then
    vecho "$PROG: copied $count file(s) into worktree per .worktreeinclude"
  fi
}

# Resolve the devShell flake ref for DIR: the repo's own devShells.<system>.
# <target> if present, else csb's generic fallback (with a warning to stderr).
# Shared by the main launch and by run_worktreesetup's sandboxing below.
#
# The target is `default` unless --nix-target (or its per-mode variants, or the
# matching profile keys) names another -- e.g. a leaner `ci` closure. A NAMED
# target never falls back: csb's generic fallback only ever provides `default`,
# so silently substituting it would run the wrong closure. Missing -> die.
resolve_devshell_ref() {
  local dir="$1" system target="$nix_target_effective"
  case "$(uname -s)-$(uname -m)" in
    Darwin-arm64)              system="aarch64-darwin" ;;
    Darwin-x86_64)             system="x86_64-darwin" ;;
    Linux-x86_64)              system="x86_64-linux" ;;
    Linux-aarch64|Linux-arm64) system="aarch64-linux" ;;
    *)                         system="" ;;
  esac
  # nix flakes ignore UNTRACKED files, so a brand-new flake.nix that hasn't
  # been `git add`ed is invisible to nix develop -- the eval below treats that
  # as "no devShell" and falls back too.
  if [[ ! -f "$dir/flake.nix" ]] || \
     { [[ -n "$system" ]] && ! nix eval "$dir#devShells.$system.$target.name" >/dev/null 2>&1; }; then
    if [[ "$target" != "default" ]]; then
      die "no devShells.$system.$target in the flake at $dir (nix target '$target')"
    fi
    echo "$PROG: no repo devShell at $dir -- using csb's generic fallback devShell" >&2
    echo "$PROG: add devShells.default for a project toolchain (nix flake init -t $CSB_SELF; git add flake.nix)" >&2
    echo "$CSB_SELF#fallback"
    return
  fi
  [[ "$target" == "default" ]] && { echo "$dir"; return; }
  echo "$dir#$target"
}

# Source <worktree>/.worktreesetup.sh (present + executable) and dispatch to its
# up/down functions, SANDBOXED: inside the repo's own devShell and the same
# deny-list containment (build_deny_wrapper) the eventual claude/-s launch
# gets, with the same env scrub (--ignore-environment + keep_args). So the
# script has no more host access than the agent's own shell already would --
# no git-tracked/unmodified gate is needed, since there is no longer a
# privilege gap to escalate into. $1 is the action (up|down), $2 the worktree,
# $3 the branch. `up` provisions (after .worktreeinclude, on every
# launch/create/reuse/-n) and must be idempotent; a non-zero exit aborts csb.
# `down` tears down on --delete, before the worktree is removed; a non-zero
# exit only warns, so --delete still completes.
run_worktreesetup() {
  local action="$1" wt_path="$2" branch="$3"
  [[ -f "$wt_path/.worktreesetup.sh" ]] || return 0

  local devshell_ref
  devshell_ref=$(resolve_devshell_ref "$wt_path")

  # Scoped locals: build_deny_wrapper/build_write_roots read these globals
  # dynamically. No namespace HOME here -- up/down run before the namespace is
  # resolved and need none of its state; the write-allow roots are just the
  # worktree, its git dir, and tmp.
  local worktree="$wt_path" ns_dir="" claude_home="" cfg_tmpdir=""
  build_deny_wrapper

  # shellcheck disable=SC2016  # single-quoted: expands inside the bash -c below, not here
  local script='
prog="$1"; act="$2"; branch="$3"
if [[ ! -x .worktreesetup.sh ]]; then
  echo "$prog: warning: .worktreesetup.sh exists but is not executable; skipping" >&2
  echo "  (chmod +x it to have csb run it)" >&2
  exit 0
fi
# shellcheck disable=SC1091
source .worktreesetup.sh "$branch"
if declare -F "$act" >/dev/null 2>&1; then
  "$act" "$branch"
fi
'
  local rc=0
  vecho "$PROG: .worktreesetup.sh $action $branch (sandboxed, in the devShell)"
  (
    cd "$wt_path" || exit 1
    nix develop "$devshell_ref" "${nix_quiet[@]+"${nix_quiet[@]}"}" --ignore-environment "${keep_args[@]}" \
      --command "${deny_wrapper[@]}" bash -c "$script" csb-worktreesetup "$PROG" "$action" "$branch"
  ) || rc=$?
  # Unlike the final claude/-s launch, csb regains control right after this
  # call (it isn't exec'd away), so the macOS seatbelt profile can be reaped
  # immediately instead of waiting on the EXIT trap / OS temp reaper.
  if [[ -n "$seatbelt_profile" ]]; then
    rm -f "$seatbelt_profile"
    seatbelt_profile=""
  fi

  if (( rc != 0 )); then
    if [[ "$action" == "up" ]]; then
      die ".worktreesetup.sh up failed (exit $rc); not launching claude.
  fix the script (or the worktree) and re-run $PROG"
    fi
    echo "$PROG: warning: .worktreesetup.sh down failed (exit $rc); continuing with delete" >&2
  fi
}

# claude auths via a forwarded token: HOME is redirected away from any
# logged-in ~/.claude (which the deny-list blocks anyway), so a host login is
# never visible. Warn if nothing is exported to forward.
warn_if_no_token() {
  if [[ -z "${CLAUDE_CODE_OAUTH_TOKEN:-}" ]]; then
    echo "$PROG: warning: CLAUDE_CODE_OAUTH_TOKEN is not set;" >&2
    echo "  claude runs with a private HOME, so your host login isn't visible." >&2
    echo "  Generate a token once with 'claude setup-token' and export it —" >&2
    echo "  or set token_cmd in a profile (-p)." >&2
  fi
}

# Export the host's effective git identity as GIT_AUTHOR_*/GIT_COMMITTER_* so the
# agent can commit: HOME is redirected away from the real ~/.gitconfig (and the
# deny-list blocks it), so without these git wouldn't know who's committing.
# Left unset if git has no identity configured.
export_git_identity() {
  local git_name git_email
  git_name=$(git -C "$repo_root" config user.name 2>/dev/null || true)
  git_email=$(git -C "$repo_root" config user.email 2>/dev/null || true)
  if [[ -n "$git_name" ]]; then export GIT_AUTHOR_NAME="$git_name" GIT_COMMITTER_NAME="$git_name"; fi
  if [[ -n "$git_email" ]]; then export GIT_AUTHOR_EMAIL="$git_email" GIT_COMMITTER_EMAIL="$git_email"; fi
}

# Seed an onboarding-complete + folder-trusted .claude.json so interactive claude
# starts from CLAUDE_CODE_OAUTH_TOKEN without a login/trust prompt. Host-side,
# into the namespace/throwaway config (never the real ~/.claude.json). Idempotent:
# a jq merge preserves existing state; a fresh file is written directly (no jq).
#   $1 = .claude.json to seed; $2 = project (cwd) key to trust
seed_claude_config() {
  local cfg="$1" proj="$2" base tmp
  mkdir -p "$(dirname "$cfg")"
  if command -v jq >/dev/null 2>&1; then
    base='{}'; [[ -s "$cfg" ]] && base="$(cat "$cfg")"
    tmp="$(mktemp)"
    printf '%s' "$base" | jq --arg p "$proj" \
      '.hasCompletedOnboarding = true
       | .projects[$p].hasTrustDialogAccepted = true
       | .projects[$p].projectOnboardingSeenCount = ((.projects[$p].projectOnboardingSeenCount) // 1)' \
      > "$tmp" && mv "$tmp" "$cfg"
  elif [[ "$proj" == *'"'* || "$proj" == *\\* ]]; then
    echo "$PROG: warning: jq not found and the project path needs JSON escaping;" >&2
    echo "  not seeding $cfg — claude may prompt for login/trust. Install jq." >&2
  elif [[ ! -s "$cfg" ]]; then
    # No jq, but a fresh/empty file needs no merge — write the minimal seed
    # (proj is guarded above against JSON-significant characters).
    cat > "$cfg" <<EOF
{
  "hasCompletedOnboarding": true,
  "projects": {
    "$proj": { "hasTrustDialogAccepted": true, "projectOnboardingSeenCount": 1 }
  }
}
EOF
  else
    echo "$PROG: warning: jq not found; can't merge the onboarding seed into the existing" >&2
    echo "  $cfg — claude may prompt for login/trust. Install jq." >&2
  fi
}

# Seed the launch HOME from a template dir (profile seed_home=, else
# ~/.config/csb/home) so in-sandbox claude sees user-level files (CLAUDE.md,
# settings.json, rules/) otherwise hidden by the deny-list + HOME redirection.
# Copies the template's contents non-overwriting (--reseed overwrites), every
# launch. Only what you place in the template crosses in -- never a real-HOME
# sweep, so it can't re-expose what the deny-list protects.
#   $1 = destination HOME (the namespace or ephemeral dir)
seed_home_template() {
  local dest="$1" tmpl explicit="false"
  if [[ -n "$seed_home" ]]; then tmpl="$seed_home"; explicit="true"; else tmpl="$CSB_CONFIG_DIR/home"; fi
  if [[ ! -d "$tmpl" ]]; then
    # A missing DEFAULT dir is the common case (no template configured) — silent.
    # A configured seed_home that doesn't resolve is likely a typo — say so.
    [[ "$explicit" == "true" ]] && echo "$PROG: warning: seed_home is not a directory: $tmpl (nothing seeded)" >&2
    return 0
  fi
  mkdir -p "$dest"
  local count=0 src rel target action
  # -type f only: reconstruct the tree file-by-file (parents via mkdir -p). cp -p
  # preserves the executable bit so seeded hooks/scripts stay runnable.
  while IFS= read -r -d '' src; do
    rel="${src#"$tmpl"/}"
    target="$dest/$rel"
    if [[ -e "$target" ]]; then
      [[ "$reseed" != "true" ]] && continue   # keep existing (default)
      action="reseeded (overwrote)"
    else
      action="seeded"
    fi
    mkdir -p "$(dirname "$target")"
    cp -p "$src" "$target"
    vecho "$PROG: $action HOME/$rel"
    count=$((count + 1))
  done < <(find "$tmpl" -mindepth 1 -type f -print0)
  # NB: an `if` block (not `(( count > 0 )) && echo`) so the function returns 0
  # when nothing was copied — under `set -e`, a trailing `&&` that short-circuits
  # would make this bare call abort csb on every no-op (re)launch.
  if (( count > 0 )); then
    vecho "$PROG: seeded $count file(s) into HOME from $tmpl"
  fi
}

# Resolve the effective claude namespace, i.e. which HOME the launched process
# gets. Sets the global ns_dir (empty = ephemeral) and exports
# CSB_CLAUDE_CONFIG_DIR. The three overrides and the default are mutually
# exclusive HOME choices:
#   --real-home    -> the operator's REAL HOME (no redirect, no dir)
#   -E/--ephemeral -> throwaway config/HOME under tmp (no namespace)
#   -N NAME        -> shared, cross-repo HOME at ~/.csb/claudes/@NAME
#                     (the leading @ is optional: NAME and @NAME are the same)
#   default        -> one persistent HOME per REPO at ~/.csb/claudes/repo-<key>,
#                     shared across all the repo's branches/worktrees
# There is no sticky state: the default is derived from the repo every run, so
# `csb BRANCH` is deterministic without remembering anything.
setup_namespace() {
  local ns
  ns_dir=""

  if [[ "$real_home" == "true" ]]; then
    # No redirection: HOME stays the operator's real HOME (kept through the env
    # scrub). No namespace dir, no CLAUDE_CONFIG_DIR override, and (below) no
    # seeding -- csb must never write into the real ~/.claude.
    export CSB_CLAUDE_CONFIG_DIR=""
    vecho "$PROG: HOME: real ($HOME)  (no namespace, no redirection)"
    return
  fi

  if [[ "$ephemeral" == "true" ]]; then
    csb_ephemeral="true"
    export CSB_CLAUDE_CONFIG_DIR=""
    vecho "$PROG: namespace: ephemeral  (throwaway config)"
    return
  fi

  # HOME redirects to <ns>, so the config dir is <ns>/.claude (coincides with
  # claude's default $HOME/.claude).
  if [[ -n "$namespace" ]]; then
    # -N NAME and -N @NAME both name the SAME shared, cross-repo namespace: one
    # dir at ~/.csb/claudes/@NAME, never auto-removed. The auto-@ prefix keeps
    # user names in their own flat space, so none can alias a repo-<key> dir.
    ns="@${namespace#@}"
    ns_dir="$CSB_NS_ROOT/$ns"
    mkdir -p "$ns_dir/.claude"
    echo "kind=shared" > "$ns_dir/.csb-ns"
    export CSB_CLAUDE_CONFIG_DIR="$ns_dir/.claude"
    csb_ns="$ns"
    vecho "$PROG: namespace: $ns  (persistent, shared across repos: $ns_dir)"
    return
  fi

  # Default: one persistent HOME per repo (repo-<basename>-<pathhash>), shared
  # by every branch and worktree of the repo. Not tied to any one branch, so it
  # is never auto-pruned or removed by -d.
  ns="repo-$ns_repo_key"
  ns_dir="$CSB_NS_ROOT/$ns"
  mkdir -p "$ns_dir/.claude"
  echo "kind=repo" > "$ns_dir/.csb-ns"
  export CSB_CLAUDE_CONFIG_DIR="$ns_dir/.claude"
  csb_ns="$ns"
  vecho "$PROG: namespace: $ns  (persistent, per-repo: $ns_dir)"
}

# --- deny-list / write policy -----------------------------------------------------
# Two filesystem policies for the launched process (see README for rationale):
#   READS:  default-allow minus a deny-list (built-in floor + add-only
#           deny_read=/--deny-read); the active namespace is re-allowed.
#   WRITES: default-deny plus an allow-list (worktree minus its own .git file,
#           git common dir minus hooks/config, namespace HOME, tmp, /dev;
#           + allow_write=/--allow-write).

# True when realpath'd absolute paths $1 and $2 are equal or one contains the
# other. Used to reject a --paranoid-allow-read that overlaps any deny root.
paths_overlap() {
  local a="$1" b="$2"
  [[ "$a" == "$b" || "$a" == "$b"/* || "$b" == "$a"/* ]]
}

# Echo the canonical form of $1 WITHOUT requiring it to exist: realpath the
# deepest existing ancestor and re-append the rest. Needed because a socket the
# operator names may not be bound yet at launch (a test suite starts its database
# later), while the rule still has to be written against the resolved path.
# `realpath -m` does this in one call but is GNU-only, and the primary install is a
# plain copy of this script rather than the coreutils-wrapped flake output.
canon_path() {
  local p="$1" tail="" r
  while [[ ! -e "$p" && "$p" != "/" ]]; do
    tail="/$(basename "$p")$tail"
    p="$(dirname "$p")"
  done
  r="$(realpath "$p")"
  [[ -n "$tail" && "$r" == "/" ]] && r=""
  printf '%s\n' "$r$tail"
}

# True when path $1 is exactly one of $2.. -- equality, NOT containment, so a
# subdirectory of a listed root does not match (build_socket_allows relies on that
# distinction: a shared write root is refused, a subdirectory of one is not).
path_in_list() {
  local needle="$1"; shift
  local p
  for p in "$@"; do [[ "$needle" == "$p" ]] && return 0; done
  return 1
}

# Populate the global arrays deny_dirs / deny_files: built-in defaults + the
# user lists (deny_read=/--deny-read), canonicalized (realpath — seatbelt matches
# resolved paths; symlinked HOMEs), missing paths skipped, classified dir vs file.
build_deny_paths() {
  deny_dirs=()
  deny_files=()
  local -a raw=(
    "$HOME/.ssh"
    "$HOME/.aws"
    "$HOME/.gnupg"
    "$HOME/.password-store"
    "$HOME/.claude"
    "$HOME/.claude.json"
    "$HOME/.csb/claudes"
    "$HOME/.netrc"
    "$HOME/.git-credentials"
    "$HOME/.config/gh"
    "$HOME/.config/gcloud"
    "$HOME/.kube"
    "$HOME/.docker"
    "$HOME/.gitconfig"
    "$HOME/.config/git"
    "$HOME/.bash_history"
    "$HOME/.zsh_history"
    "$HOME/.cargo/credentials"
    "$HOME/.cargo/credentials.toml"
    "$HOME/.gem/credentials"
    "$HOME/.pypirc"
    "$HOME/.m2/settings.xml"
    # cloud / infra / secret-store credentials
    "$HOME/.azure"
    "$HOME/.oci"
    "$HOME/.vault-token"
    "$HOME/.terraformrc"
    "$HOME/.terraform.d"
    "$HOME/.granted"
    "$HOME/.config/containers/auth.json"
    "$HOME/.config/age/keys.txt"
    "$HOME/.config/sops"
    "$HOME/.sops"
    "$HOME/.pulumi/credentials.json"
    "$HOME/.databrickscfg"
    "$HOME/.databrickscfg.bak"
    "$HOME/.databricks"
    "$HOME/.config/doctl"
    "$HOME/.config/fly"
    "$HOME/.config/rclone"
    "$HOME/.config/op"
    "$HOME/.config/configstore"
    "$HOME/.config/github-copilot"
    "$HOME/.gemini"
    "$HOME/.mc"
    "$HOME/.minio"
    "$HOME/.s3cfg"
    "$HOME/.boto"
    "$HOME/.pgpass"
    "$HOME/.my.cnf"
    "$HOME/.claude.json.backup"
    # REPL / shell / editor history (can capture typed secrets)
    "$HOME/.python_history"
    "$HOME/.node_repl_history"
    "$HOME/.irb_history"
    "$HOME/.rdbg_history"
    "$HOME/.pry_history"
    "$HOME/.rediscli_history"
    "$HOME/.mysql_history"
    "$HOME/.psql_history"
    "$HOME/.psql_history.d"
    "$HOME/.sqlite_history"
    "$HOME/.scala_history"
    "$HOME/.scala_history_jline3"
    "$HOME/.dotty_history"
    "$HOME/.utop-history"
    "$HOME/.ammonite"
    "$HOME/.hivehistory"
    "$HOME/.lesshst"
    "$HOME/.viminfo"
    "$HOME/.local/share/fish/fish_history"
    "$HOME/.local/share/nvim/shada"
  )
  # NOT in the floor (may be needed for in-sandbox installs against private
  # registries): ~/.npmrc, ~/.bundle/config, ~/.yarnrc — add them via
  # deny_read=/--deny-read if your repos don't need them.
  if [[ "$(uname -s)" == "Darwin" ]]; then
    raw+=(
      "$HOME/Library/Keychains"
      "$HOME/Library/Cookies"
      "$HOME/Library/Safari"
      "$HOME/Library/Application Support/Google/Chrome"
      "$HOME/Library/Application Support/Firefox"
      "$HOME/.zsh_sessions"
    )
  else
    raw+=(
      "$HOME/.local/share/keyrings"
      "$HOME/.mozilla"
      "$HOME/.config/google-chrome"
      "$HOME/.config/chromium"
    )
  fi

  # User additions from profile vars (deny_read=) and CLI flags (--deny-read),
  # already ~/-expanded and validated absolute at capture time.
  raw+=("${deny_read_paths[@]+"${deny_read_paths[@]}"}")

  local p rp
  for p in "${raw[@]}"; do
    [[ -e "$p" ]] || continue
    rp=$(realpath "$p")
    # Both wrapper syntaxes quote paths; a double quote or backslash would
    # break (or silently alter) the seatbelt profile string, so refuse it
    # rather than emit a broken (weaker) profile.
    case "$rp" in
      *'"'*|*\\*) die "deny path contains a double quote or backslash (unsupported): $rp" ;;
    esac
    if [[ -d "$rp" ]]; then
      deny_dirs+=("$rp")
    else
      deny_files+=("$rp")
    fi
  done
}

# Populate two globals: write_roots, every root the launched process may write
# under (everything else is read-only, or read-denied per the deny-list), and
# own_roots, the subset csb itself creates -- worktree, git common dir, launch
# HOME. The active namespace / ephemeral HOME is handled separately per platform.
#
# own_roots exists for the macOS unix-socket re-allow (build_deny_wrapper): a
# socket under a tree csb created is one the sandbox itself made, while /tmp and
# the per-user temp dir are writable but SHARED with the host, so a socket there
# may be a host service. Write policy cannot make that distinction; socket policy
# must.
# Consumes the globals worktree, claude_home, cfg_tmpdir.
build_write_roots() {
  write_roots=(); own_roots=()
  local -a cand=("$worktree") own=("$worktree")
  local gc
  gc=$(git -C "$worktree" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)
  # Commits from a linked worktree write objects/refs into the MAIN repo's git
  # dir, so it must be writable (hooks/ and config are re-denied afterwards).
  [[ -n "$gc" ]] && { cand+=("$gc"); own+=("$gc"); }
  # The ephemeral HOME is a write root; the REAL HOME under --real-home is NOT
  # (writes stay default-deny -- the shell reaches the fs via --no-sandbox, not
  # by widening the write policy).
  [[ -n "$claude_home" && -z "$ns_dir" && "$real_home" != "true" ]] \
    && { cand+=("$claude_home"); own+=("$claude_home"); }
  [[ -n "$cfg_tmpdir" ]] && cand+=("$cfg_tmpdir")
  cand+=("/tmp")
  if [[ "$(uname -s)" == "Darwin" ]]; then
    # The per-user /var/folders/... dir (covers both the T/ temp and C/ cache
    # subdirs, which system frameworks write to) and the device tree (ptys;
    # the TUI writes its terminal). The case below is what makes this safe, not
    # the use of getconf: getconf itself falls back to $TMPDIR when the confstr
    # lookup is denied (measured inside a sandbox), and TMPDIR points at a /tmp
    # subpath under nix develop, whose parent resolves to /private — far too
    # broad to write-allow. Anything not under /var/folders is refused.
    local dtmp dpar=""
    dtmp="$(getconf DARWIN_USER_TEMP_DIR 2>/dev/null || true)"
    [[ -n "$dtmp" && -d "$dtmp" ]] && dpar="$(dirname "$(realpath "$dtmp")")"
    case "$dpar" in
      /var/folders/*|/private/var/folders/*) cand+=("$dpar") ;;
      *) echo "$PROG: warning: per-user temp dir did not resolve under /var/folders ('$dpar');" >&2
         echo "  not write-allowing it — /tmp stays writable" >&2 ;;
    esac
    cand+=("/dev")
  else
    cand+=("/var/tmp")
  fi

  # User additions from profile vars (allow_write=) and CLI flags (--allow-write),
  # already ~/-expanded and validated absolute at capture time.
  cand+=("${allow_write_paths[@]+"${allow_write_paths[@]}"}")

  local p rp
  for p in "${cand[@]}"; do
    [[ -n "$p" && -e "$p" ]] || continue
    rp=$(realpath "$p")
    case "$rp" in
      *'"'*|*\\*) die "allow-write path contains a double quote or backslash (unsupported): $rp" ;;
    esac
    write_roots+=("$rp")
  done
  # own is a subset of cand, so the quote check above has already covered it.
  for p in "${own[@]}"; do
    [[ -n "$p" && -e "$p" ]] || continue
    own_roots+=("$(realpath "$p")")
  done
}

# Populate the global ipc_brokers: the host IPC broker paths csb removes from the
# sandbox (docs/PLAN-007-escape.md F3/F4). Linux mounts a tmpfs over each one that
# exists; macOS closes them with the network-outbound class deny and needs no
# per-path rule. The list is platform-INDEPENDENT because the refusals below use
# it too: a profile shared across a mac and a Linux box must fail identically on
# both, rather than erroring on one host and silently passing on the other.
build_ipc_brokers() {
  ipc_brokers=("/run/user/$(id -u)" /run/dbus /nix/var/nix/daemon-socket)
  # The nix daemon socket is a SYMLINK out of that directory on macOS
  # (/nix/var/nix/daemon-socket/socket -> /private/var/run/nix-daemon.socket), so
  # the directory alone does not cover it: naming the link resolves past the
  # refusal and hands back the F3 socket. Add the resolved target. Harmless in the
  # Linux tmpfs loop, which mounts only the entries that are directories.
  ipc_brokers+=("$(canon_path /nix/var/nix/daemon-socket/socket)")
}

# Die if any path in $2.. overlaps an IPC broker path, comparing BOTH the path as
# given and its resolved form: a symlink can point into a broker directory, and on
# macOS the nix daemon socket is a symlink pointing OUT of one. $1 labels the source.
# On Linux the write binds are emitted AFTER the --tmpfs that removes these, so an
# overlapping --allow-write would layer the host directory back on top and reopen
# the session-bus escape (PLAN-007 D9). Refusing beats reordering: a --tmpfs
# landing on a path the operator asked to be writable is its own confusion, and
# the boundary is not a knob -- the deny/allow READ lists deliberately do let a
# later rule win, but the IPC denies have no opt-out except --no-sandbox.
# Reads the caller's ipc_brokers array (bash dynamic scope).
refuse_ipc_brokers() {
  local label="$1"; shift
  local p rp b
  for p in "$@"; do
    rp=$(canon_path "$p")
    for b in "${ipc_brokers[@]}"; do
      if paths_overlap "$rp" "$b" || paths_overlap "$p" "$b"; then
        die "$label '$p' overlaps the IPC broker path '$b' (csb closes it unconditionally; --no-sandbox is the only way back)"
      fi
    done
  done
  return 0
}

# Populate the globals socket_subpaths / socket_literals from allow_socket_paths:
# unix sockets the operator named, which the macOS network-outbound class deny
# would otherwise cut (PLAN-007 amendment Part 7). Consumes write_roots/own_roots
# (build_write_roots) and ipc_brokers (build_ipc_brokers).
#
# A DIRECTORY becomes a subpath and anything else a literal, matching
# build_deny_paths' split -- except that a path which does not exist YET is also
# treated as a directory, so a socket dir the test suite creates on boot is
# covered rather than silently emitting a rule that can never match. Each path is
# emitted in BOTH spellings when they differ: seatbelt matches the resolved path
# (/tmp -> /private/tmp), so the realpath form is the load-bearing one, and the
# as-given form is the cheap half of the same lesson the mDNSResponder pair
# records. Repeated allows are idempotent in seatbelt.
build_socket_allows() {
  socket_subpaths=(); socket_literals=()
  local p rp
  refuse_ipc_brokers "allow_socket" "${allow_socket_paths[@]+"${allow_socket_paths[@]}"}"
  for p in "${allow_socket_paths[@]+"${allow_socket_paths[@]}"}"; do
    rp=$(canon_path "$p")
    case "$rp" in
      *'"'*|*\\*) die "allow_socket path contains a double quote or backslash (unsupported): $rp" ;;
    esac
    # A whole SHARED write root is refused: /tmp and the per-user temp dir are
    # writable but shared with the host, so a subpath over one makes host sockets
    # reachable again -- measured, and the reason own_roots exists. A socket FILE
    # or a subdirectory under them is one named thing and is allowed.
    if [[ -d "$rp" ]] \
       && path_in_list "$rp" "${write_roots[@]+"${write_roots[@]}"}" \
       && ! path_in_list "$rp" "${own_roots[@]+"${own_roots[@]}"}"; then
      die "allow_socket '$p' is a shared write root (name a socket or a subdirectory under it, not the whole tree)"
    fi
    if [[ -d "$rp" || ! -e "$rp" ]]; then
      socket_subpaths+=("$rp")
      [[ "$rp" == "$p" ]] || socket_subpaths+=("$p")
    else
      socket_literals+=("$rp")
      [[ "$rp" == "$p" ]] || socket_literals+=("$p")
    fi
  done
}

# macOS seatbelt: re-allow traversal of the DENIED ancestor directories of $1,
# walking parent-ward and stopping at the first ancestor under no deny root
# (above that they are already reachable). A subtree re-allowed beneath a denied
# root is unreachable otherwise: per-component path resolution -- canonicalizing a
# path lstats every component, a directory glob opendirs each -- hits the first
# denied ancestor and fails with EPERM even when the target itself is allowed.
# $2 is the seatbelt op class granted on each ancestor: default file-read-metadata
# (lstat only), or file-read* to also permit opendir/listing (needed by tools
# that scan ancestors upward for a project root or config). `literal` scopes each
# allow to exactly that ancestor dir, so siblings under it stay denied -- listing
# an ancestor leaks only its immediate entry NAMES, never their contents (see
# README, "paranoid guarantee"). Reads the caller's deny_subpaths array (bash
# dynamic scope); emitted AFTER the deny rules so the later allow wins. Repeated
# allows across roots are idempotent in seatbelt.
emit_ancestor_metadata() {
  local p d under class="${2:-file-read-metadata}"
  p=$(dirname "$1")
  while [[ "$p" != "/" ]]; do
    under="false"
    for d in "${deny_subpaths[@]+"${deny_subpaths[@]}"}"; do
      if [[ "$p" == "$d" || "$p" == "$d"/* ]]; then under="true"; break; fi
    done
    [[ "$under" == "true" ]] || break
    printf '(allow %s (literal "%s"))\n' "$class" "$p"
    p=$(dirname "$p")
  done
}

# Assemble the global deny_wrapper argv that wraps the innermost command:
#   darwin -> (/usr/bin/sandbox-exec -f <generated profile>)
#   linux  -> (<store bwrap> --ro-bind / / ... --)
# Consumes ns_dir (set by setup_namespace; empty for ephemeral) to re-allow the
# active namespace, and build_write_roots for the write policy. sandbox-exec is
# deprecated-but-stable (nix's own darwin sandbox uses the same libsandbox); if
# it ever disappears, this helper is the single place to swap the mechanism.
# Set proxy_port for the profile's one IP-egress rule. Under --filter-egress the
# proxy runs OUTSIDE the sandbox, as the operator, and the sandbox reaches it on
# loopback and nothing else. Under --dump-sandbox nothing is started: a
# placeholder keeps the seam hermetic and its goldens stable.
#
# Linux is a no-op for now. bwrap has no socket filter, so HTTP_PROXY there is
# advisory -- a process can dial out directly and ignore it. Enforcement needs a
# network namespace (P4); emitting a loopback-only rule without one would LOOK
# like filtering while enforcing nothing, which is worse than declining.
start_egress_proxy() {
  [[ "$filter_egress" == "true" ]] || return 0
  if [[ "$(uname -s)" != "Darwin" ]]; then
    echo "$PROG: warning: --filter-egress is macOS-only for now; egress is NOT filtered on this platform" >&2
    filter_egress="false"
    return 0
  fi
  if [[ -n "$dump" ]]; then
    proxy_port="<PROXY_PORT>"
    return 0
  fi
  local bin fifo
  # CSB_PROXY_BIN overrides with a verbatim path (keeps tests and a working-tree
  # build hermetic); otherwise resolve it from csb's own flake, the same way
  # #bwrap is resolved on Linux, so an installed csb needs nothing on PATH.
  if [[ -n "${CSB_PROXY_BIN:-}" ]]; then
    bin="$CSB_PROXY_BIN"
  else
    local out=""
    # Tolerate the failure so the hint below replaces nix's bare attribute error:
    # a git+ssh CSB_SELF with no ?ref= resolves the remote's DEFAULT branch, so a
    # new output living on a feature branch is simply absent.
    # nix's own stderr is left visible: it names the actual cause (a missing
    # attribute, an eval error, a build failure), and hiding it behind a generic
    # hint costs more than the hint adds.
    out="$(nix build "$CSB_SELF#csb-tools" "${nix_quiet[@]+"${nix_quiet[@]}"}" \
             --no-link --print-out-paths || true)"
    if [[ -z "$out" ]]; then
      echo "$PROG: could not build csb-proxy from $CSB_SELF#csb-tools (nix error above)" >&2
      echo "  a git remote CSB_SELF resolves its DEFAULT branch: add ?ref=<branch> for an" >&2
      echo "  output that is not merged yet. Otherwise: CSB_SELF=path:/path/to/csb, or" >&2
      echo "  set CSB_PROXY_BIN to a csb-proxy built with 'make ocaml-build'." >&2
      die "--filter-egress could not resolve csb-proxy"
    fi
    bin="$out/bin/csb-proxy"
  fi
  [[ -x "$bin" ]] \
    || die "--filter-egress resolved csb-proxy to a non-executable path: $bin"
  [[ ${#allow_host_list[@]} -gt 0 ]] \
    || die "--filter-egress with an empty host allowlist would block all egress: add --allow-host, a profile allow_host=, or $CSB_CONFIG_DIR/allowed-hosts"
  proxy_allow_file="$(mktemp "${TMPDIR:-/tmp}/csb-allow.XXXXXX")"
  printf '%s\n' "${allow_host_list[@]}" >"$proxy_allow_file"
  # The decision log goes in the launch HOME so the SANDBOX can read it: a denied
  # CONNECT reaches the agent as an opaque transport error, and this file is the
  # only way it can tell policy from packet loss.
  proxy_log="${claude_home:-${TMPDIR:-/tmp}}/csb-proxy.log"
  fifo="$(mktemp -u "${TMPDIR:-/tmp}/csb-proxyport.XXXXXX")"
  mkfifo "$fifo"
  # Decisions arrive on the proxy's stderr; appending it to the log keeps one
  # writer (and captures a failed start, which --log-file would not). stdout is
  # the port channel and must stay clean. The proxy's own --log-file exists for
  # `make proxy-run`, where stderr is the operator's live view instead.
  "$bin" "$proxy_allow_file" >"$fifo" 2>>"$proxy_log" &
  proxy_pid=$!
  proxy_port="$(head -1 <"$fifo")"
  rm -f "$fifo"
  [[ "$proxy_port" =~ ^[0-9]+$ ]] \
    || die "csb-proxy did not report a port (see $proxy_log)"
  vecho "$PROG: egress filtered via csb-proxy on 127.0.0.1:$proxy_port (${#allow_host_list[@]} hosts); log: $proxy_log"
}

build_deny_wrapper() {
  deny_wrapper=()
  build_deny_paths
  build_write_roots
  local -a ipc_brokers=() socket_subpaths=() socket_literals=()
  build_ipc_brokers
  # A write root may not re-open a broker path csb closes (PLAN-007 D9), and
  # neither may an allow_socket (checked inside build_socket_allows).
  refuse_ipc_brokers "allow_write" "${allow_write_paths[@]+"${allow_write_paths[@]}"}"
  build_socket_allows
  local ns_real="" gc_real="" hooks_deny="" config_deny="" cfgwt_deny="" \
        wt_gitdir="" wt_cfgwt_deny="" wt_gitfile_deny="" real_home
  real_home=$(realpath "$HOME")
  # Extra --paranoid read-deny/allow roots (paranoid_deny_read=/--paranoid-deny-read
  # and paranoid_allow_read=/--paranoid-allow-read), canonicalized and existence-
  # checked like the deny-list. The write-root re-allows below reopen the active
  # worktree on top (later rule wins), so a broad deny like /Volumes never locks
  # the agent out of its own repo. A paranoid_allow_read re-exposes a slice of the
  # paranoid HOME deny read-only (no write), but is rejected if it overlaps any
  # explicit deny (floor, deny_read, or paranoid_deny_read) so the emitted profile
  # stays unambiguous -- re-exposing a denied path is never silently resolved.
  local -a paranoid_deny_roots=() paranoid_allow_roots=()
  if [[ "$paranoid" == "true" ]]; then
    local pp pr d
    for pp in "${paranoid_deny_read_paths[@]+"${paranoid_deny_read_paths[@]}"}"; do
      [[ -e "$pp" ]] || continue
      pr=$(realpath "$pp")
      case "$pr" in
        *'"'*|*\\*) die "paranoid_deny_read path contains a double quote or backslash (unsupported): $pr" ;;
      esac
      paranoid_deny_roots+=("$pr")
    done
    for pp in "${paranoid_allow_read_paths[@]+"${paranoid_allow_read_paths[@]}"}"; do
      [[ -e "$pp" ]] || continue
      pr=$(realpath "$pp")
      case "$pr" in
        *'"'*|*\\*) die "paranoid_allow_read path contains a double quote or backslash (unsupported): $pr" ;;
      esac
      for d in "${deny_dirs[@]+"${deny_dirs[@]}"}" "${deny_files[@]+"${deny_files[@]}"}" \
               "${paranoid_deny_roots[@]+"${paranoid_deny_roots[@]}"}"; do
        paths_overlap "$pr" "$d" \
          && die "paranoid_allow_read '$pr' overlaps deny root '$d' (an allow may not re-expose a denied path)"
      done
      paranoid_allow_roots+=("$pr")
    done
  fi
  if [[ -n "$ns_dir" ]]; then
    ns_real=$(realpath "$ns_dir")
  fi
  gc_real=$(git -C "$worktree" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)
  [[ -n "$gc_real" ]] && gc_real=$(realpath "$gc_real")
  # Host code-exec vectors inside the writable git common dir, denied even
  # when the path does not exist yet: an existence-conditional deny would let
  # the sandbox CREATE .git/hooks/pre-commit (or a config) and gain host
  # execution. config.worktree gets the same treatment as config (git reads
  # it when extensions.worktreeConfig is set): both the common-dir copy and
  # the linked worktree's own gitdir copy.
  if [[ -n "$gc_real" ]]; then
    hooks_deny="$gc_real/hooks"
    config_deny="$gc_real/config"
    cfgwt_deny="$gc_real/config.worktree"
    wt_gitdir=$(git -C "$worktree" rev-parse --path-format=absolute --git-dir 2>/dev/null || true)
    if [[ -n "$wt_gitdir" && -e "$wt_gitdir" ]]; then
      wt_gitdir=$(realpath "$wt_gitdir")
      if [[ "$wt_gitdir" != "$gc_real" ]]; then
        wt_cfgwt_deny="$wt_gitdir/config.worktree"
        # A linked worktree's .git is a FILE naming that gitdir, and it sits
        # inside the writable worktree. It is what every later launch resolves
        # the main checkout from -- and with it the namespace HOME and the
        # config sections that grant capability -- so repointing it chooses
        # policy, which is the .git/hooks class of vector.
        wt_gitfile_deny="$(realpath "$worktree")/.git"
      fi
    fi
  fi

  # Deny roots whose interior a per-component path resolver must still traverse
  # (metadata-only) to reach a re-allowed subtree beneath them: the dir-form
  # deny-list always, plus the real HOME and paranoid_deny roots under
  # --paranoid. Consumed by emit_ancestor_metadata (macOS seatbelt only; Linux
  # bwrap materializes the ancestors as tmpfs dirs when it binds the subtree).
  local -a deny_subpaths=("${deny_dirs[@]+"${deny_dirs[@]}"}")
  if [[ "$paranoid" == "true" ]]; then
    deny_subpaths+=("$real_home" "${paranoid_deny_roots[@]+"${paranoid_deny_roots[@]}"}")
  fi

  case "$(uname -s)" in
    Darwin)
      local profile p
      profile=$(mktemp "${TMPDIR:-/tmp}/csb-deny.XXXXXX")
      # Reap the profile if csb dies between here and the final exec. The trap
      # deliberately does NOT fire on the exec itself: sandbox-exec reads the
      # file after csb is gone; the temp dir reaps it eventually (paths only,
      # no secrets).
      seatbelt_profile="$profile"
      trap 'rm -f "$seatbelt_profile" "$proxy_allow_file"; [[ -z "$proxy_pid" ]] || kill "$proxy_pid" 2>/dev/null' EXIT
      {
        echo "(version 1)"
        echo "(allow default)"
        # IPC policy (docs/PLAN-007-escape.md). The file rules below constrain
        # syscalls; these constrain BROKERS -- a host service asked to act on the
        # sandboxed process's behalf does its work outside the profile, as the
        # operator. Deny by CLASS, not by service name: five guessed mach names
        # failed to block `open` before the blanket deny worked.
        #   mach-lookup      -- mach + XPC named services (LaunchServices/`open`,
        #                       the pasteboard, AppleEvents, the window server).
        #                       Three names are re-allowed and no more: two for
        #                       DNS (with them, DNS/HTTPS/claude match the
        #                       unsandboxed host) and one for getpwuid. Without
        #                       the third, uid->name resolution fails -- `id -un`
        #                       and `whoami` print the raw uid, and libpq refuses
        #                       to connect over ANY transport. It is
        #                       opendirectoryd.LIBINFO; the .api name that probe
        #                       rows A2-A4 cleared as unnecessary is a different
        #                       service and does not fix it.
        #   network-outbound -- AF_UNIX connect() is this class, so denying the
        #                       class and re-allowing IP keeps egress while
        #                       cutting every host socket (nix daemon, tmux,
        #                       editor IPC, docker, ssh-agent). The two
        #                       mDNSResponder literals are load-bearing: without
        #                       them DNS fails even though its mach service is
        #                       allowed (measured, probe rows A5 vs A7). The
        #                       own_roots re-allow below is what keeps the
        #                       sandbox's OWN sockets working.
        #   mach-priv-task-port -- task_for_pid: macOS has no PID namespace, so
        #                       every host process is otherwise addressable.
        #                       Never demonstrated reachable (the OS already
        #                       gates it on root or a debugger entitlement); it
        #                       is free, so the class is denied anyway.
        # NOT denied: sysctl. The kern.procargs2 disclosure (every same-uid
        # process's argv AND environment) is NOT closeable here -- a name-prefix
        # deny cannot match it, because the read goes through the numeric MIB
        # {CTL_KERN, KERN_PROCARGS2, pid}, which has no string name. Measured
        # with a compiled probe: `kern.procargs`, `kern.proc`, blanket
        # (deny sysctl-read) and (deny sysctl*) all still leak, and the blanket
        # forms break `sysctl` and `uname`. Documented as an unfixable gap.
        echo "(deny mach-lookup)"
        echo '(allow mach-lookup (global-name "com.apple.dnssd.service"))'
        echo '(allow mach-lookup (global-name "com.apple.mDNSResponder"))'
        echo '(allow mach-lookup (global-name "com.apple.system.opendirectoryd.libinfo"))'
        # --pasteboard: pbcopy/pbpaste, off by default. Re-allowing these was
        # measured NOT to hand LaunchServices a route back (PLAN-007 row PB);
        # test/escape/escape.bats keeps that a regression guard.
        if [[ "$pasteboard" == "true" ]]; then
          echo '(allow mach-lookup (global-name "com.apple.pasteboard.1"))'
          echo '(allow mach-lookup (global-name "com.apple.lsd.mapdb"))'
          echo '(allow mach-lookup (global-name "com.apple.lsd.modifydb"))'
        fi
        # This also closes the nix daemon socket (PLAN-007 F3) with no
        # nix-specific rule: denying the `nix` BINARY would be worthless anyway,
        # since /tmp is a write root and exec is unrestricted.
        echo "(deny network-outbound)"
        # --filter-egress: the ONLY reachable IP endpoint becomes csb-proxy on
        # loopback, so every host the agent reaches is one the allowlist named.
        # Unfiltered, IP egress stays wide open (the historical default).
        # Enforcement is structural, not cooperative: HTTP_PROXY tells a client
        # where to go, but this rule is what leaves it nowhere else.
        if [[ "$filter_egress" == "true" ]]; then
          printf '(allow network-outbound (remote ip "localhost:%s"))\n' "$proxy_port"
          # --allow-port: host-local TCP services (a dev server, postgres over
          # TCP) the proxy cannot carry, since it speaks CONNECT to public names.
          for p in "${allow_port_list[@]+"${allow_port_list[@]}"}"; do
            printf '(allow network-outbound (remote ip "localhost:%s"))\n' "$p"
          done
        else
          echo '(allow network-outbound (remote ip "*:*"))'
        fi
        # Kept under filtering too: the proxy resolves names, but removing these
        # was never measured, and DNS is not the egress channel -- the IP rule
        # above is. See PLAN-008-proxy.md s10 item 3.
        echo '(allow network-outbound (literal "/private/var/run/mDNSResponder"))'
        echo '(allow network-outbound (literal "/var/run/mDNSResponder"))'
        # Unix sockets INSIDE the sandbox's own trees: a Rails tmp/sockets/
        # puma.sock, spring, an in-tree `pg_ctl -k`. Those trees are created and
        # owned by the sandbox, so a socket there is one the sandbox itself made
        # -- unlike /tmp or /var/folders, which are shared with the host and
        # therefore stay denied (measured: re-allowing /private/tmp makes a HOST
        # socket in /tmp reachable again, which is F3's shape returning).
        for p in "${own_roots[@]+"${own_roots[@]}"}" "$ns_real"; do
          [[ -n "$p" ]] || continue
          printf '(allow network-outbound (subpath "%s"))\n' "$p"
        done
        # --allow-socket / allow_socket=: host sockets the operator named, for a
        # dev setup built on unix sockets (a postgres .s.PGSQL.5432) that TCP would
        # otherwise be the only way to reach. Scoped to those paths and nothing
        # else; build_socket_allows refuses the broker paths and the shared write
        # roots, so neither this flag nor a profile can undo the class deny.
        for p in "${socket_subpaths[@]+"${socket_subpaths[@]}"}"; do
          printf '(allow network-outbound (subpath "%s"))\n' "$p"
        done
        for p in "${socket_literals[@]+"${socket_literals[@]}"}"; do
          printf '(allow network-outbound (literal "%s"))\n' "$p"
        done
        echo "(deny mach-priv-task-port)"
        echo "(deny iokit-open)"
        # READ policy: deny-list (later rules win; the active namespace is
        # re-allowed under the denied ~/.csb/claudes parent).
        for p in "${deny_dirs[@]+"${deny_dirs[@]}"}"; do
          printf '(deny file* (subpath "%s"))\n' "$p"
        done
        for p in "${deny_files[@]+"${deny_files[@]}"}"; do
          printf '(deny file* (literal "%s"))\n' "$p"
        done
        # PARANOID reads: deny everything under the real HOME, then re-allow the
        # write roots (and the namespace, below) so the devShell still resolves.
        if [[ "$paranoid" == "true" ]]; then
          printf '(deny file-read* (subpath "%s"))\n' "$real_home"
          for p in "${paranoid_deny_roots[@]+"${paranoid_deny_roots[@]}"}"; do
            printf '(deny file-read* (subpath "%s"))\n' "$p"
          done
          for p in "${write_roots[@]+"${write_roots[@]}"}"; do
            printf '(allow file-read* (subpath "%s"))\n' "$p"
            # List (not just stat) the write-root's denied ancestors so upward
            # ancestor scans resolve; leaks ancestor entry NAMES only (README).
            emit_ancestor_metadata "$p" 'file-read*'
          done
          # paranoid_allow_read: re-expose these read-only (no matching write-root
          # allow), disjoint from every deny by the overlap check above.
          for p in "${paranoid_allow_roots[@]+"${paranoid_allow_roots[@]}"}"; do
            printf '(allow file-read* (subpath "%s"))\n' "$p"
            emit_ancestor_metadata "$p" 'file-read*'
          done
          # matching-class read re-allow: a later file* allow does not override an
          # earlier file-read* deny in seatbelt (the namespace file* allow below).
          [[ -n "$ns_real" ]] && printf '(allow file-read* (subpath "%s"))\n' "$ns_real"
        fi
        # The active namespace is re-allowed under the denied ~/.csb/claudes
        # parent in BOTH modes, so restore ancestor traversal unconditionally.
        if [[ -n "$ns_real" ]]; then
          printf '(allow file* (subpath "%s"))\n' "$ns_real"
          emit_ancestor_metadata "$ns_real"
        fi
        # WRITE policy: allow-list.
        echo "(deny file-write*)"
        for p in "${write_roots[@]+"${write_roots[@]}"}"; do
          printf '(allow file-write* (subpath "%s"))\n' "$p"
        done
        if [[ -n "$ns_real" ]]; then
          printf '(allow file-write* (subpath "%s"))\n' "$ns_real"
        fi
        # Host code-execution and policy vectors inside the writable git trees
        # (string-matched by seatbelt, so nonexistence doesn't weaken them).
        if [[ -n "$hooks_deny" ]]; then
          printf '(deny file-write* (subpath "%s"))\n' "$hooks_deny"
        fi
        for p in "$config_deny" "$cfgwt_deny" "$wt_cfgwt_deny" "$wt_gitfile_deny"; do
          [[ -n "$p" ]] || continue
          printf '(deny file-write* (literal "%s"))\n' "$p"
        done
      } > "$profile"
      deny_wrapper=(/usr/bin/sandbox-exec -f "$profile")
      ;;
    Linux)
      # Store path resolved host-side (before the env scrub) so the wrapper
      # doesn't rely on bubblewrap being on any PATH. --unshare-pid: other
      # processes are invisible and unsignalable. No --unshare-net /
      # --unshare-ipc: open host access is a requirement.
      local bwrap_bin p
      # CSB_BWRAP_BIN overrides the store build with a verbatim path: keeps
      # --dump-sandbox / tests hermetic (a stable placeholder, no nested nix)
      # and lets a host point at an already-built bwrap. Otherwise build it.
      if [[ -n "${CSB_BWRAP_BIN:-}" ]]; then
        bwrap_bin="$CSB_BWRAP_BIN"
      else
        bwrap_bin="$(nix build "$CSB_SELF#bwrap" "${nix_quiet[@]+"${nix_quiet[@]}"}" --no-link --print-out-paths)/bin/bwrap"
      fi
      deny_wrapper=("$bwrap_bin" --ro-bind / / --dev-bind /dev /dev --proc /proc
                    --unshare-pid --die-with-parent)
      # IPC policy (docs/PLAN-007-escape.md). `--ro-bind / /` carries every host
      # socket into the namespace and a read-only bind does NOT block connect(),
      # so a broker outside the namespace will act for the sandbox as the
      # operator: `systemd-run --user` over the session bus was a full escape.
      # bwrap has no socket filter, so the only lever is removing the socket --
      # per-path, and therefore NOT complete (see the README's Known gaps:
      # abstract sockets are network-namespace scoped and unreachable this way).
      # Skipped when absent: bwrap cannot mkdir a mountpoint under the ro root.
      for p in "${ipc_brokers[@]}"; do
        [[ -d "$p" ]] && deny_wrapper+=(--tmpfs "$p")
      done
      # --allow-socket is a deliberate NO-OP here: every path it can name is
      # already reachable, since a ro bind does not block connect() and the
      # brokers above are refused. The one exception is a socket under a tree a
      # tmpfs removes (the real HOME under --paranoid, a paranoid_deny_read root);
      # no bind is emitted to bring it back, because that is exactly the silent
      # re-open D9 fixes. Relay such a socket into the worktree instead.
      # PARANOID reads: blank the real HOME; the write-root binds below (and the
      # namespace bind) re-expose exactly what the devShell needs to read.
      [[ "$paranoid" == "true" ]] && deny_wrapper+=(--tmpfs "$real_home")
      for p in "${paranoid_deny_roots[@]+"${paranoid_deny_roots[@]}"}"; do
        deny_wrapper+=(--tmpfs "$p")
      done
      # WRITE policy: rw-bind the allowed roots over the read-only root.
      for p in "${write_roots[@]+"${write_roots[@]}"}"; do
        deny_wrapper+=(--bind "$p" "$p")
      done
      # paranoid_allow_read: re-expose these read-only over the tmpfs'd HOME
      # (no write, unlike the rw binds above); disjoint from every deny.
      for p in "${paranoid_allow_roots[@]+"${paranoid_allow_roots[@]}"}"; do
        deny_wrapper+=(--ro-bind "$p" "$p")
      done
      # bwrap needs the bind source to exist: materialize absent deny targets
      # host-side (empty placeholders are inert for git) so the sandbox can't
      # create them rw through the parent bind.
      if [[ -n "$hooks_deny" ]]; then
        mkdir -p "$hooks_deny"
        deny_wrapper+=(--ro-bind "$hooks_deny" "$hooks_deny")
      fi
      for p in "$config_deny" "$cfgwt_deny" "$wt_cfgwt_deny" "$wt_gitfile_deny"; do
        [[ -n "$p" ]] || continue
        [[ -e "$p" ]] || touch "$p"
        deny_wrapper+=(--ro-bind "$p" "$p")
      done
      # READ policy: mount ordering matters — the ~/.csb/claudes parent is
      # tmpfs'd here, then the active namespace is bound back in (rw) last.
      for p in "${deny_dirs[@]+"${deny_dirs[@]}"}"; do
        deny_wrapper+=(--tmpfs "$p")
      done
      for p in "${deny_files[@]+"${deny_files[@]}"}"; do
        deny_wrapper+=(--ro-bind /dev/null "$p")
      done
      if [[ -n "$ns_real" ]]; then
        deny_wrapper+=(--bind "$ns_real" "$ns_real")
      fi
      deny_wrapper+=(--)
      ;;
    *)
      die "unsupported platform for the deny-list sandbox: $(uname -s)"
      ;;
  esac
}

# --- profiles ---------------------------------------------------------------------
#
# Read/write/socket lists are profile vars (deny_read=, allow_write=, allow_socket=,
# paranoid_deny_read=, paranoid_allow_read=) + the matching CLI flags; the tmp dir
# is CSB_TMPDIR. The
# old machine-wide config (~/.config/csb/{config,deny,allow-write}) is no longer
# read.

# Seed the launch config with the HOST's native claude session credential (macOS
# keychain / linux ~/.claude/.credentials.json) so the sandbox presents the same
# live subscription session as native claude. Host-side, every launch; the
# secret is never echoed. Sandbox and native share one refresh-token family, so
# occasional mutual re-login prompts are possible.
seed_credentials() {
  local dir="$1" blob src
  mkdir -p "$dir"
  if [[ "$(uname -s)" == "Darwin" ]]; then
    blob=$(security find-generic-password -a "$USER" -w -s "Claude Code-credentials" 2>/dev/null) \
      || die "seed_creds: no 'Claude Code-credentials' keychain item (log in with native claude first)"
    [[ "$blob" == *claudeAiOauth* ]] \
      || die "seed_creds: unexpected keychain blob shape (expected claudeAiOauth JSON)"
    (umask 077; printf '%s\n' "$blob" > "$dir/.credentials.json")
  else
    src="$HOME/.claude/.credentials.json"
    [[ -f "$src" ]] || die "seed_creds: $src not found (log in with native claude first)"
    (umask 077; cp "$src" "$dir/.credentials.json")
    chmod 600 "$dir/.credentials.json"
  fi
  vecho "$PROG: seeded host session credentials into the launch config"
}

# Run the profile's token_cmd host-side; stdout becomes CLAUDE_CODE_OAUTH_TOKEN
# (never echoed). Failure or empty output aborts the launch — before any
# worktree/namespace side effects.
run_token_cmd() {
  [[ -n "$token_cmd" ]] || return 0
  local tok
  tok=$(bash -c "$token_cmd") || die "profile token_cmd failed: $token_cmd"
  [[ -n "$tok" ]] || die "profile token_cmd produced no output: $token_cmd"
  export CLAUDE_CODE_OAUTH_TOKEN="$tok"
}

# --- config resolution ------------------------------------------------------------
#
# csb-config owns the flag grammar, the profiles, their validation, --help and
# --dump-config. It answers those three itself and otherwise hands back a
# resolved configuration, so this script never re-derives a knob the two could
# then disagree about. See docs/PLAN-008-proxy.md section 9.

# The csb-config binary, in order: CSB_CONFIG_BIN verbatim, one sitting beside
# this script, this repo's own dune build, $CSB_TOOLS_DIR where `make install`
# puts it, then PATH. There is deliberately no nix fallback the way csb-proxy
# has one -- this runs on every invocation, and a `nix build` in front of
# `csb --help` is not a trade worth making.
csb_config_bin() {
  local self dir found tree
  if [[ -n "${CSB_CONFIG_BIN:-}" ]]; then printf '%s' "$CSB_CONFIG_BIN"; return; fi
  self="$(command -v "$0" 2>/dev/null || printf '%s' "$0")"
  dir="$(cd "$(dirname "$self")" 2>/dev/null && pwd -P)" || dir=""
  if [[ -n "$dir" && -x "$dir/csb-config" ]]; then printf '%s' "$dir/csb-config"; return; fi
  # A working tree: ./bin/csb beside an ocaml/ that `make ocaml-build` has built.
  # It comes before the installed copies so that running the tree tests the tree,
  # which is how csb's own verification seams are driven.
  tree="$dir/../ocaml/_build/default/bin/csb_config_cli.exe"
  if [[ -n "$dir" && -x "$tree" ]]; then printf '%s' "$tree"; return; fi
  if [[ -x "$CSB_TOOLS_DIR/csb-config" ]]; then printf '%s' "$CSB_TOOLS_DIR/csb-config"; return; fi
  found="$(command -v csb-config 2>/dev/null)" || found=""
  if [[ -n "$found" ]]; then printf '%s' "$found"; return; fi
  die "csb-config not found in $CSB_TOOLS_DIR, beside $PROG, or on PATH (run 'make install', or set CSB_CONFIG_BIN)"
}

# Every scalar key csb-config emits, checked off as the records arrive. An
# unknown key is loud on its own, but a VANISHED one would not be: `paranoid` or
# `filter_egress` going missing would weaken the sandbox while looking like an
# ordinary default. Lists are absent when empty, so only scalars can be required.
csb_config_scalars=(dump mode no_launch here shell paranoid pasteboard
                    nix_target_effective sandbox real_home yolo latest verbose
                    namespace branch ephemeral ephemeral_name profile seed_creds
                    seed_home reseed accent cfg_tmpdir token_cmd filter_egress)

# Run csb-config over this invocation's argv and read the resolution back into
# the globals below. The wire format is NUL-terminated KEY=VALUE records, a list
# key repeating once per element: NUL is the one byte a path, a claude argument
# or a setenv value cannot hold, so no value can split itself into two. The
# child's output is parsed, never eval'd.
resolve_config() {
  local bin emit rc=0 rec k v unknown="" seen=" "
  bin="$(csb_config_bin)"
  # The file carries token_cmd, so it is created private and unlinked as soon as
  # it is read.
  emit="$(mktemp "${TMPDIR:-/tmp}/csb-resolve.XXXXXX")"
  # exec -a so csb-config's diagnostics, usage line and version name the program
  # the operator actually typed. CSB_MAIN_ROOT carries the repo identity its
  # config sections are selected by: git stays on this side of the seam, so
  # there is one derivation of it. An inherited value is honoured verbatim, an
  # inherited EMPTY one included -- that is how the tests select sections
  # without a repository.
  ( export CSB_EMIT_TO="$emit" CSB_MAIN_ROOT="${CSB_MAIN_ROOT-$(main_checkout_root)}"
    exec -a "$PROG" "$bin" "$@" ) || rc=$?
  if [[ "$rc" -ne 0 ]]; then
    rm -f "$emit"
    # 2 means csb-config answered the operator itself (--help, --version,
    # --dump-config) and resolved nothing. Any other status already said why.
    if [[ "$rc" -eq 2 ]]; then exit 0; fi
    exit "$rc"
  fi
  [[ -s "$emit" ]] \
    || { rm -f "$emit"; die "csb-config exited 0 without resolving anything"; }
  while IFS= read -r -d '' rec; do
    k="${rec%%=*}"; v="${rec#*=}"
    seen+="$k "
    case "$k" in
      dump)                 dump="$v" ;;
      mode)                 mode="$v" ;;
      no_launch)            no_launch="$v" ;;
      here)                 here="$v" ;;
      shell)                shell="$v" ;;
      paranoid)             paranoid="$v" ;;
      pasteboard)           pasteboard="$v" ;;
      nix_target_effective) nix_target_effective="$v" ;;
      sandbox)              sandbox="$v" ;;
      real_home)            real_home="$v" ;;
      yolo)                 yolo="$v" ;;
      latest)               latest="$v" ;;
      verbose)              verbose="$v" ;;
      namespace)            namespace="$v" ;;
      branch)               branch="$v" ;;
      ephemeral)            ephemeral="$v" ;;
      ephemeral_name)       ephemeral_name="$v" ;;
      profile)              profile_name="$v" ;;
      seed_creds)           seed_creds="$v" ;;
      seed_home)            seed_home="$v" ;;
      reseed)               reseed="$v" ;;
      accent)               accent="$v" ;;
      cfg_tmpdir)           cfg_tmpdir="$v" ;;
      token_cmd)            token_cmd="$v" ;;
      filter_egress)        filter_egress="$v" ;;
      claude_args)          claude_args+=("$v") ;;
      keep)                 extra_keep+=("$v") ;;
      setenv)               profile_setenv+=("$v") ;;
      deny_read)            deny_read_paths+=("$v") ;;
      allow_write)          allow_write_paths+=("$v") ;;
      allow_socket)         allow_socket_paths+=("$v") ;;
      allow_host)           allow_host_list+=("$v") ;;
      allow_port)           allow_port_list+=("$v") ;;
      paranoid_deny_read)   paranoid_deny_read_paths+=("$v") ;;
      paranoid_allow_read)  paranoid_allow_read_paths+=("$v") ;;
      *) unknown="$k"; break ;;
    esac
  done <"$emit"
  rm -f "$emit"
  [[ -z "$unknown" ]] || die "csb-config emitted an unknown key: '$unknown'"
  for k in "${csb_config_scalars[@]}"; do
    [[ "$seen" == *" $k "* ]] || die "csb-config emitted no '$k' (mismatched versions?)"
  done
}

# Every knob csb-config resolves. The scalars carry csb-config's own defaults so
# that a reader under `set -u` is never surprised; the arrays must exist before
# resolve_config appends to them.
dump=""             # "" | sandbox: the read-only seam that still needs this script
mode="launch"
no_launch="false"
here="false"
shell="false"
paranoid="false"
pasteboard="false"
nix_target_effective="default"  # devShells.<system>.NAME for THIS launch mode
sandbox="true"
real_home="false"
yolo="false"
latest="false"
verbose="false"
namespace=""
branch=""
ephemeral="false"
ephemeral_name=""
profile_name=""
seed_creds="false"
seed_home=""
reseed="false"
accent=""
cfg_tmpdir=""
token_cmd=""
filter_egress="false"
claude_args=()
extra_keep=()
profile_setenv=()
deny_read_paths=()
allow_write_paths=()
allow_socket_paths=()
allow_host_list=()
allow_port_list=()
paranoid_deny_read_paths=()
paranoid_allow_read_paths=()

# Launch state, not configuration: filled in as the launch proceeds.
seatbelt_profile=""  # macOS: generated profile path, reaped by trap on abnormal exit
proxy_port=""        # resolved at launch; a placeholder under --dump-sandbox
proxy_pid=""         # reaped by the launch trap
proxy_allow_file=""  # temp file csb-proxy reads the allowlist from
proxy_log=""         # decision log, inside the launch HOME so the agent can read it
ns_dir=""
claude_home=""       # set once the namespace/ephemeral HOME is resolved; empty
                     # default lets run_worktreesetup call build_deny_wrapper
                     # earlier (under set -u) with no namespace HOME involved
csb_ns=""            # resolved namespace name (empty for ephemeral)
csb_ephemeral="false"

resolve_config "$@"

# Quiet nix's own progress/eval output unless verbose. Expanded into every
# host-side nix build/develop below via the safe empty-array pattern.
nix_quiet=(); [[ "$verbose" == "true" ]] || nix_quiet=(--quiet)

# The env scrub allowlist: computed early (before ensure_worktree/
# run_worktreesetup) so both the sandboxed .worktreesetup.sh call and the real
# claude/-s launch get the identical scrub. nix sets PATH/toolchain from the
# devShell, so `env` and the absolute paths resolve. HOME is kept (real) so
# the devShell shellHook has one; the `env` wrapper at launch then overrides
# HOME for the launched process and its children. SSH_AUTH_SOCK is
# deliberately NOT kept — SSH push/fetch stays in your own shell.
# __NIXOS_SET_ENVIRONMENT_DONE: on NixOS, an interactive bash (SYS_BASHRC =
# /etc/bashrc) re-sources /etc/set-environment when the guard var is missing,
# clobbering the devShell PATH. Keeping it is a no-op elsewhere.
keep_vars=(HOME USER TERM LANG LC_ALL CLAUDE_CODE_OAUTH_TOKEN
           GIT_AUTHOR_NAME GIT_AUTHOR_EMAIL GIT_COMMITTER_NAME GIT_COMMITTER_EMAIL
           __NIXOS_SET_ENVIRONMENT_DONE)
keep_vars+=("${extra_keep[@]+"${extra_keep[@]}"}")
keep_args=()
for v in "${keep_vars[@]}"; do keep_args+=(--keep "$v"); done

# Host-side credential work, before any worktree/namespace side effects (a
# token_cmd failure must abort a clean launch, not a half-prepared one).
# Skipped for delete/list/prepare-only invocations, which launch nothing (the
# branch/--here term keeps a listing run out of the password store); the -s
# shell skips token_cmd too (it runs no claude — no reason to touch it).
if [[ "$mode" == "launch" && "$no_launch" != "true" && "$shell" != "true" \
      && -z "$dump" && ( -n "$branch" || "$here" == "true" ) ]]; then
  run_token_cmd
fi

# --- locate repo ----------------------------------------------------------------

git rev-parse --git-dir >/dev/null 2>&1 || die "not in a git repository"
repo_root=$(git rev-parse --show-toplevel)
ns_repo_key=$(repo_key "$repo_root")
# The main checkout root: differs from repo_root when run from inside a linked
# worktree. List/namespace modes read from here so they work from anywhere.
main_root=$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")

# --- namespace list mode ------------------------------------------------------------

if [[ "$mode" == "list_ns" ]]; then
  [[ -z "$branch" ]] || die "--list-ns takes no BRANCH argument"
  this_repo="repo-$ns_repo_key"
  echo "csb namespaces under $CSB_NS_ROOT:"
  count=0; legacy=0
  if [[ -d "$CSB_NS_ROOT" ]]; then
    shopt -s nullglob
    for d in "$CSB_NS_ROOT"/*; do
      [[ -d "$d" ]] || continue
      ns=$(basename "$d")
      count=$((count + 1))
      case "$ns" in
        "$this_repo") printf '  %-34s per-repo default (this repo)\n' "$ns" ;;
        repo-*)       printf '  %-34s per-repo default (another repo)\n' "$ns" ;;
        @*)           printf '  %-34s shared across repos\n' "$ns" ;;
        *)            printf '  %-34s LEGACY pre-0.3 per-branch layout (remove manually)\n' "$ns"
                      legacy=$((legacy + 1)) ;;
      esac
    done
    shopt -u nullglob
  fi
  (( count > 0 )) || echo "  (none)"
  if (( legacy > 0 )); then
    echo "$PROG: $legacy legacy dir(s) from the pre-0.3 per-branch layout remain;" >&2
    echo "  they are never used or auto-removed -- delete when ready: rm -rf $CSB_NS_ROOT/<name>" >&2
  fi
  exit 0
fi

# --- list mode (no branch, launch, not --here) ------------------------------------

if [[ "$mode" == "launch" && -z "$branch" && "$here" != "true" ]]; then
  echo "csb worktrees under $main_root/.worktrees:"
  # `|| true` keeps pipefail from tripping when there are no matching worktrees
  # (awk exits 0 either way) or `git worktree list` fails outside a repo.
  git -C "$main_root" worktree list 2>/dev/null \
    | awk -v pre="$main_root/.worktrees/" 'index($1, pre) == 1' || true
  exit 0
fi

# The worktree flow operates from the main checkout; --here intentionally runs
# in the current dir (which may itself be a worktree), so skip the guard there.
if [[ "$here" != "true" ]] && in_worktree; then
  die "refusing to operate from inside a worktree: $repo_root
  run $PROG from the main checkout instead"
fi

# --- delete mode ------------------------------------------------------------------

if [[ "$mode" == "delete" ]]; then
  [[ -n "$branch" ]] || die "delete mode requires a branch name"
  wt_path=$(find_worktree "$repo_root" "$branch")
  # Teardown/removal only ever applies to worktrees csb created under
  # .worktrees/ — find_worktree returns ANY checkout of the branch, including
  # the main tree or a hand-made worktree, which -d must not touch (running
  # the repo's `down` teardown against them would be destructive).
  wt_refused="false"
  if [[ -n "$wt_path" ]]; then
    case "$wt_path" in
      "$repo_root"/.worktrees/*) ;;
      *)
        echo "$PROG: branch '$branch' is checked out at $wt_path — not a csb worktree;" >&2
        echo "  leaving it alone (only the namespace config is removed, below)" >&2
        wt_path=""
        wt_refused="true"
        ;;
    esac
  fi
  if [[ -z "$wt_path" && "$wt_refused" != "true" ]]; then
    candidate=$(worktree_path "$repo_root" "$branch")
    [[ -d "$candidate" ]] && wt_path="$candidate"
  fi
  if [[ -z "$wt_path" ]]; then
    [[ "$wt_refused" == "true" ]] || echo "$PROG: no worktree for '$branch'"
  elif [[ -d "$wt_path" ]]; then
    run_worktreesetup down "$wt_path" "$branch"
    echo "$PROG: removing worktree $wt_path"
    if ! git -C "$repo_root" worktree remove "$wt_path"; then
      echo "$PROG: worktree remove failed (uncommitted or untracked files?)" >&2
      echo "  to force: git -C $repo_root worktree remove --force $wt_path" >&2
      exit 1
    fi
  else
    echo "$PROG: pruning stale worktree registration for '$branch'"
    git -C "$repo_root" worktree prune
  fi

  # -d removes only the worktree. The launch HOME is now per-repo (shared by all
  # the repo's branches) or a shared @-namespace -- neither is tied to a single
  # branch, so deleting a worktree never removes a config. Retire a namespace
  # deliberately with `rm -rf <dir>`; point there if one was named explicitly.
  if [[ "$ephemeral" != "true" && -n "$namespace" ]]; then
    ns_name="@${namespace#@}"
    echo "$PROG: namespace '$ns_name' is shared and not tied to this branch -- not removing." >&2
    echo "  to retire it deliberately: rm -rf $CSB_NS_ROOT/$ns_name" >&2
  fi
  exit 0
fi

# --- launch mode ------------------------------------------------------------------

if [[ "$here" == "true" ]]; then
  # No worktree: run in the current directory (quick/lightweight ops). cwd is
  # the live checkout, so it's less isolated than a worktree.
  worktree="$PWD"
else
  [[ -n "$branch" ]] || die "branch name required"
  worktree=$(ensure_worktree "$repo_root" "$branch") || exit 1
  process_worktreeinclude "$repo_root" "$worktree"
  run_worktreesetup up "$worktree" "$branch"
fi
# --no-launch is purely a worktree-prep step (the namespace only matters at
# launch), so exit before setup_namespace — no stray ~/.csb/claudes dir.
if [[ "$no_launch" == "true" ]]; then
  if [[ "$here" == "true" ]]; then
    echo "$PROG: --no-launch: nothing to prepare for --here" >&2
  else
    echo "$PROG: prepared worktree (not launching claude)" >&2
  fi
  echo "$worktree"
  exit 0
fi

# csb runs inside a devShell. Prefer the repo's own flake devShell; if the repo
# has none for this system, fall back to a generic devShell from csb's own
# flake so the sandbox can still run against repos that don't ship a flake.
devshell_ref=$(resolve_devshell_ref "$worktree")

setup_namespace

cd "$worktree"

# Git identity for the agent's commits (see the helper).
export_git_identity

# -L/--latest: re-lock the claude-code input to a concrete upstream rev (checked
# at most once per CSB_LATEST_TTL, see latest_claude_rev), instead of the rev
# pinned in CSB_SELF's committed flake.lock. This defeats the lock to give the
# newest claude at the cost of reproducibility; pinning a concrete rev keeps
# nix's fetch cached across same-day launches. Empty array = use the lock as-is.
# The input name must match flake.nix's inputs.claude-code.
nix_latest_args=()
# The -s shell never builds claude, so skip the upstream check there entirely.
# --dump-sandbox never launches, so it skips the (networked) upstream check too.
if [[ "$latest" == "true" && "$shell" != "true" && -z "$dump" ]]; then
  claude_rev="$(latest_claude_rev)"
  nix_latest_args=(--override-input claude-code "$CSB_CLAUDE_FLAKE/$claude_rev")
fi

# Per-namespace HOME/config for the *launched* process only, injected via an
# `env` wrapper on the command — NOT exported into csb. csb's own `nix build`/
# `nix develop` must keep the real HOME so nix can read ~/.config/nix, its eval
# cache, and the ssh keys / tokens needed to fetch CSB_SELF and the repo's
# flake inputs (all nix runs host-side, unsandboxed — the trust model).
#  - persistent namespace -> HOME=<ns>, CLAUDE_CONFIG_DIR=<ns>/.claude (set
#    explicitly so .claude.json lands there too).
#  - -E/--ephemeral        -> a throwaway HOME under $TMPDIR (the OS reaps it;
#    deliberately not under any denied path, so it needs no re-allow).
env_overrides=()
if [[ "$real_home" == "true" ]]; then
  # --real-home: no HOME / CLAUDE_CONFIG_DIR override -- the env scrub keeps the
  # real HOME (it's in keep_vars). claude_home names it only for the launch
  # messages and the ~/bin PATH prepend; it is never seeded or write-allowed.
  claude_home="$HOME"
  claude_json="$HOME/.claude.json"
  vecho "$PROG: real HOME: $claude_home (not redirected, not seeded)"
elif [[ -n "${CSB_CLAUDE_CONFIG_DIR:-}" ]]; then
  claude_home="$(dirname "$CSB_CLAUDE_CONFIG_DIR")"
  env_overrides=("HOME=$claude_home" "CLAUDE_CONFIG_DIR=$CSB_CLAUDE_CONFIG_DIR")
  claude_json="$CSB_CLAUDE_CONFIG_DIR/.claude.json"
elif [[ -n "$ephemeral_name" ]]; then
  # Named ephemeral: a DETERMINISTIC throwaway HOME under the same tmp base the
  # random one uses (already a write root, undenied), so a sibling `csb -s
  # -E=NAME` in another pane lands in the exact same env. Not a namespace: no
  # ~/.csb/claudes entry, no provenance stamp, untracked by --list-ns; the OS
  # reaps it from tmp. Both panes must resolve the same base (set tmpdir= in
  # config, or keep $TMPDIR stable) for the paths to coincide.
  claude_home="${cfg_tmpdir:-${TMPDIR:-/tmp}}/csb-home-$ephemeral_name"
  (umask 077; mkdir -p "$claude_home")
  env_overrides=("HOME=$claude_home")
  claude_json="$claude_home/.claude.json"
  vecho "$PROG: named ephemeral HOME (reusable): $claude_home"
else
  claude_home="$(mktemp -d "${cfg_tmpdir:-${TMPDIR:-/tmp}}/csb-home.XXXXXX")"
  env_overrides=("HOME=$claude_home")
  claude_json="$claude_home/.claude.json"
  vecho "$PROG: ephemeral HOME: $claude_home"
fi
# Seed user-level files into the launch HOME from the template dir, BEFORE the
# onboarding seed below so a template-provided .claude.json is merged (via jq),
# not overwritten. Skipped under --dump-sandbox (it resolves and prints only).
# Never seed the real HOME (--real-home): the template copy and the onboarding
# .claude.json merge are only for a redirected/throwaway HOME.
if [[ -z "$dump" && "$real_home" != "true" ]]; then
  seed_home_template "$claude_home"
  seed_claude_config "$claude_json" "$worktree"
fi
if [[ -n "$cfg_tmpdir" ]]; then
  env_overrides+=("TMPDIR=$cfg_tmpdir")
fi
# Host-session credential seeding (see the helper). The -s shell runs no
# claude, so it gets no credential dance at all (and no token warning); the
# seeded session makes the token warning moot otherwise. Skipped under
# --dump-sandbox (never touches the keychain / seeded credentials).
if [[ -n "$dump" ]]; then
  :
elif [[ "$shell" == "true" ]]; then
  if [[ "$seed_creds" == "true" ]]; then
    echo "$PROG: warning: --seed-creds has no effect with --shell (no claude runs; skipping)" >&2
  fi
elif [[ "$real_home" == "true" ]]; then
  # Real HOME: the host's own ~/.claude session is already visible (nothing is
  # redirected or denied there), so neither seed nor token warning applies --
  # and --seed-creds must not overwrite the real credential store.
  [[ "$seed_creds" == "true" ]] \
    && echo "$PROG: warning: --seed-creds has no effect with --real-home (your real ~/.claude session is used as-is)" >&2
elif [[ "$seed_creds" == "true" ]]; then
  if [[ -n "${CLAUDE_CODE_OAUTH_TOKEN:-}" ]]; then
    echo "$PROG: warning: CLAUDE_CODE_OAUTH_TOKEN is set and takes precedence over the" >&2
    echo "  seeded session credential (unset it, or drop token_cmd=, to use --seed-creds)" >&2
  fi
  seed_credentials "${CSB_CLAUDE_CONFIG_DIR:-$claude_home/.claude}"
else
  warn_if_no_token
fi

# Repo/branch-scoped env overrides: dotenv-style VAR=value lines from
# <worktree>/.worktreeenv (blank and # lines skipped). Injected through the
# same `env` wrapper as HOME — after the --ignore-environment scrub, inside
# the devShell, identically for claude and --shell. Repo-controlled like
# .worktreesetup.sh, whose `up` typically generates it per-branch. A literal
# ${HOME} in a value expands to the launch's EFFECTIVE home (the namespace
# dir when redirected, the real one otherwise) — generators run on the host
# before the namespace is resolved, so they can't know this path themselves.
if [[ -f "$worktree/.worktreeenv" ]]; then
  wte_count=0
  wte_home="${claude_home:-$HOME}"
  while IFS= read -r wte_line; do
    [[ -z "$wte_line" || "$wte_line" == \#* ]] && continue
    if [[ "$wte_line" =~ ^[A-Za-z_][A-Za-z0-9_]*= ]]; then
      # shellcheck disable=SC2016  # replacing the LITERAL string ${HOME}
      env_overrides+=("${wte_line//'${HOME}'/$wte_home}")
      wte_count=$((wte_count + 1))
    else
      echo "$PROG: warning: ignoring malformed .worktreeenv line: $wte_line" >&2
    fi
  done < "$worktree/.worktreeenv"
  (( wte_count > 0 )) && vecho "$PROG: $wte_count env override(s) from .worktreeenv"
  # Global excludes (core.excludesFile) live under the real HOME, which csb
  # redirects away — so check ignore status the way sandboxed git will see it,
  # and nudge toward the HOME-independent exclude file.
  if ! GIT_CONFIG_GLOBAL=/dev/null git -C "$worktree" check-ignore -q -- .worktreeenv 2>/dev/null; then
    echo "$PROG: note: .worktreeenv is not git-ignored inside the sandbox (global" >&2
    echo "  excludes are not read there) — add it to <repo>/.git/info/exclude" >&2
  fi
fi

# Profile setenv=, after .worktreeenv (user config beats the repo file when both
# set a var — later `env` args win).
env_overrides+=("${profile_setenv[@]+"${profile_setenv[@]}"}")

# csb's own launch state, for the sandboxed process to surface (a statusline
# script, a prompt): these csb concepts have no representation in claude's env
# or status JSON. Authoritative, so appended last (they win a name collision).
csb_mode="worktree"; [[ "$here" == "true" ]] && csb_mode="here"
env_overrides+=(
  "CSB_PROFILE=$profile_name"
  "CSB_NS=$csb_ns"
  "CSB_EPHEMERAL=$csb_ephemeral"
  "CSB_MODE=$csb_mode"
  "CSB_YOLO=$yolo"
  "CSB_PARANOID=$paranoid"
  "CSB_SANDBOX=$sandbox"
  "CSB_REAL_HOME=$real_home"
  "CSB_ACCENT=$accent"
)

# The deny-list wraps the innermost command only; nix eval/build/develop above
# and below run host-side with the real HOME, unrestricted. --no-sandbox skips
# the wrapper entirely (shell-only, enforced above): the launch degrades to
# `env ... path_shim cmd`, giving the shell full host filesystem access.
if [[ "$sandbox" == "true" ]]; then
  start_egress_proxy
  build_deny_wrapper
  # Must come after start_egress_proxy: proxy_port does not exist until it runs.
  # These tell a proxy-aware client where the proxy is; the profile above is what
  # makes it the only reachable endpoint. NO_PROXY exempts loopback so an
  # --allow-port service is dialled directly rather than refused by the proxy,
  # which only speaks CONNECT to public names.
  if [[ "$filter_egress" == "true" && -n "$proxy_port" ]]; then
    env_overrides+=(
      "HTTPS_PROXY=http://127.0.0.1:$proxy_port"
      "HTTP_PROXY=http://127.0.0.1:$proxy_port"
      "https_proxy=http://127.0.0.1:$proxy_port"
      "http_proxy=http://127.0.0.1:$proxy_port"
      "NO_PROXY=localhost,127.0.0.1"
      "no_proxy=localhost,127.0.0.1"
      "CSB_PROXY_LOG=$proxy_log"
    )
  elif [[ "$filter_egress" == "true" && -z "$dump" ]]; then
    # Unreachable unless this block is moved above start_egress_proxy again. It
    # was, once: the profile enforced correctly and the env was never injected,
    # so the sandbox had no egress at all and nothing said why. Fail loudly
    # rather than hand back a silently isolated sandbox.
    die "internal: filter_egress is on but no proxy port was resolved"
  fi
else
  deny_wrapper=()
  [[ -n "$dump" ]] \
    || echo "$PROG: NOTE: filesystem sandbox is OFF (--no-sandbox) -- this shell has full host filesystem access" >&2
fi

# --dump-sandbox: read-only Tier-2 seam. When the sandbox is on, build_deny_wrapper
# above already ran the real build path (build_deny_paths/build_write_roots and
# every validation), so print the generated artifact -- the seatbelt profile text
# on macOS, the bwrap argv one token per line on Linux -- and exit before any
# launch. The EXIT trap reaps the macOS profile after we have printed it.
if [[ "$dump" == "sandbox" ]]; then
  if [[ "$sandbox" != "true" ]]; then
    echo "(no filesystem sandbox: --no-sandbox)"
    exit 0
  fi
  case "$(uname -s)" in
    Darwin) cat "$seatbelt_profile" ;;
    *)      printf '%s\n' "${deny_wrapper[@]}" ;;
  esac
  exit 0
fi

vecho "$PROG: launching in the devShell at $worktree"
vecho "$PROG:   scrubbed env, HOME=$claude_home, fs deny-list on; network OPEN"

# Scrub the environment, re-admit only an allowlist (+ --keep VARs). See
# keep_vars/keep_args above (computed early so run_worktreesetup's sandboxed
# .worktreesetup.sh call gets the same scrub as the real launch below).

# PATH shaping at launch, in a shim that execs the real command on (nix owns
# PATH and `env` can't edit it in place). Two edits, both at shim RUNTIME so
# they see the effective HOME (real or redirected), for claude and the shell
# alike:
#   - PREPEND $HOME/bin when it exists, so the operator's own scripts (deploy
#     wrappers under --real-home; anything seeded into a namespace HOME) take
#     precedence. This intentionally outranks the devShell toolchain.
#   - APPEND /usr/bin so bare-name lookups resolve system-only tools
#     (pbcopy/pbpaste, osascript) already exec'able by absolute path -- name
#     resolution only, not the sandbox boundary. Appended LAST so the devShell's
#     GNU tools keep priority over macOS BSD ones.
# shellcheck disable=SC2016  # $HOME/$PATH/$@ must expand at shim runtime, not here
path_shim=(bash -c '
  [[ -d "$HOME/bin" ]] && PATH="$HOME/bin${PATH:+:$PATH}"
  export PATH="${PATH:+$PATH:}/usr/bin"
  exec "$@"' csb-path-shim)

# --shell: same worktree/devShell/scrub/HOME/deny-list, but exec an interactive
# bash (or the args after --) instead of claude. No claude build needed.
if [[ "$shell" == "true" ]]; then
  cmd=(bash)
  [[ ${#claude_args[@]} -gt 0 ]] && cmd=("${claude_args[@]}")
  vecho "$PROG: shell in the devShell at $worktree (claude's env, no claude)"
  exec nix develop "$devshell_ref" "${nix_quiet[@]+"${nix_quiet[@]}"}" --ignore-environment "${keep_args[@]}" \
    --command env "${env_overrides[@]+"${env_overrides[@]}"}" \
      "${deny_wrapper[@]+"${deny_wrapper[@]}"}" "${path_shim[@]}" "${cmd[@]}"
fi

claude_bin="$(nix build "${CSB_SELF}#claude" "${nix_latest_args[@]+"${nix_latest_args[@]}"}" "${nix_quiet[@]+"${nix_quiet[@]}"}" --no-link --print-out-paths)/bin/claude"
exec nix develop "$devshell_ref" "${nix_quiet[@]+"${nix_quiet[@]}"}" --ignore-environment "${keep_args[@]}" \
  --command env "${env_overrides[@]+"${env_overrides[@]}"}" \
    "${deny_wrapper[@]+"${deny_wrapper[@]}"}" "${path_shim[@]}" "$claude_bin" "${claude_args[@]+"${claude_args[@]}"}"
