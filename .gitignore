# csb per-branch worktrees (repo root only)
/.worktrees/
# per-namespace claude configs / local claude settings (repo root only;
# NOT templates/home/.claude, which is a shipped seed skeleton)
/.claude/
# keep the shipped seed skeleton even if a global excludes ignores .claude
!/templates/home/.claude/
# nix build output
result
# captured output of the manual probe harnesses: host-specific, and the results
# that matter are transcribed into docs/PLAN-007-escape.md. The .sh harnesses
# themselves ARE tracked -- they are the reproduction.
/test/manual/*.out
